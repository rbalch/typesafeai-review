# Environment variables for local development
# Copy to .env (gitignored) and fill in. Never commit secrets.
#
# `ts-review` finds this on its own (env.py, RA-01): --env-file, <worktree>/.env,
# every .env walking from cwd up to the filesystem root, then
# ~/.config/typesafe-review/env. `uv run ts-review --doctor` proves which file (if
# any) it found and that the key, base URL and model work.
TYPESAFE_API_KEY=
# The SDK appends /v1/systemone itself; do not include it here.
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-latest
